<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>{{ personalInfo.name }} — Resume</title>
    <style>
        @font-face {
            font-family: 'Open Sans';
            font-weight: 400;
            font-style: normal;
            src: url('fonts/OpenSans-Regular.ttf') format('truetype');
        }

        @font-face {
            font-family: 'Open Sans';
            font-weight: 600;
            font-style: normal;
            src: url('fonts/OpenSans-SemiBold.ttf') format('truetype');
        }

        @font-face {
            font-family: 'Open Sans';
            font-weight: 700;
            font-style: normal;
            src: url('fonts/OpenSans-Bold.ttf') format('truetype');
        }

        @font-face {
            font-family: 'Open Sans';
            font-weight: 800;
            font-style: normal;
            src: url('fonts/OpenSans-ExtraBold.ttf') format('truetype');
        }

        /* inter-regular - latin */
        @font-face {
            font-family: 'Inter';
            font-style: normal;
            font-weight: 400;
            src: url('fonts/inter-v20-latin-regular.ttf') format('truetype');
            /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
        }

        /* inter-600 - latin */
        @font-face {
            font-family: 'Inter';
            font-style: normal;
            font-weight: 600;
            src: url('fonts/inter-v20-latin-600.ttf') format('truetype');
            /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
        }

        /* inter-700 - latin */
        @font-face {
            font-family: 'Inter';
            font-style: normal;
            font-weight: 700;
            src: url('fonts/inter-v20-latin-700.ttf') format('truetype');
            /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
        }

        /* inter-800 - latin */
        @font-face {
            font-family: 'Inter';
            font-style: normal;
            font-weight: 800;
            src: url('fonts/inter-v20-latin-800.ttf') format('truetype');
            /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
        }

        /* source-serif-4-regular - latin */
        @font-face {
            font-family: 'Source Serif 4';
            font-style: normal;
            font-weight: 400;
            src: url('fonts/source-serif-4-v14-latin-regular.ttf') format('truetype');
            /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
        }

        /* source-serif-4-600 - latin */
        @font-face {
            font-family: 'Source Serif 4';
            font-style: normal;
            font-weight: 600;
            src: url('fonts/source-serif-4-v14-latin-600.ttf') format('truetype');
            /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
        }

        /* source-serif-4-700 - latin */
        @font-face {
            font-family: 'Source Serif 4';
            font-style: normal;
            font-weight: 700;
            src: url('fonts/source-serif-4-v14-latin-700.ttf') format('truetype');
            /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
        }

        /* source-serif-4-800 - latin */
        @font-face {
            font-family: 'Source Serif 4';
            font-style: normal;
            font-weight: 800;
            src: url('fonts/source-serif-4-v14-latin-800.ttf') format('truetype');
            /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
        }

        :root {
            --color-text: #000000;
            --color-text-name: {{ color_text_name }};
            --color-accent: {{ color_accent }};
            --color-bg: #FFFFFF;
            --font-main: {% for f in font_main %}"{{ f }}"{% if not loop.last %}, {% endif %}{% endfor %};
        }

        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @page {
            size: letter;
            margin: 0.55in 0.5in 0.5in 0.5in;
        }

        html,
        body {
            background: var(--color-bg);
            font-family: var(--font-main);
            color: var(--color-text);
            line-height: 1.45;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Header ── */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            border-bottom: 2.5px solid var(--color-accent);
            padding-bottom: 0.08in;
            margin-bottom: 0.18in;
        }

        .header h1 {
            font-family: var(--font-main);
            font-size: 1.85rem;
            font-weight: 800;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            color: var(--color-text-name);
            line-height: 1.1;
        }

        .contact-info {
            text-align: right;
            font-size: 0.72rem;
            color: var(--color-text-name);
        }

        .contact-info a {
            color: var(--color-text-name);
            text-decoration: none;
        }

        /* ── Section ── */
        .section {
            margin-bottom: 0.12in;
        }

        .section-title {
            font-family: var(--font-main);
            font-size: 0.68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--color-accent);
            margin-bottom: 0.06in;
        }

        /* ── Summary ── */
        .summary p {
            font-size: 0.72rem;
            line-height: 1.55;
            color: var(--color-text);
        }

        /* ── Skills ── */
        .skills-list {
            font-size: 0.72rem;
            line-height: 1.65;
        }

        .skills-list .skill-line {
            margin-bottom: 0.01in;
        }

        .skill-category {
            font-weight: 700;
            color: var(--color-text);
        }

        .skill-values {
            color: var(--color-text);
        }

        /* ── Section Items (Jobs, Education, Projects) ── */
        .section-item {
            margin-bottom: 0.1in;
            position: relative;
        }

        .section-item:last-child {
            margin-bottom: 0;
        }

        .section-item-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            font-size: 0.72rem;
            margin-bottom: 0.01in;
        }

        .section-item-primary {
            font-weight: 700;
            color: var(--color-accent);
        }

        .section-item-secondary {
            font-weight: 700;
            color: var(--color-accent);
        }

        .section-item-bullets {
            list-style: disc;
            margin-top: 0.03in;
            padding-left: 1em;
        }

        .section-item-bullets li {
            font-size: 0.72rem;
            line-height: 1.55;
            color: var(--color-text);
            margin-bottom: 0.05in;
            list-style-position: outside;
        }

        .section-item-bullets li:last-child {
            margin-bottom: 0;
        }
    </style>
</head>

<body>

    {# ── Header / Personal Info (always rendered first) ── #}
    <header class="header">
        <h1>{{ personalInfo.name }}</h1>
        <div class="contact-info">
            {{ personalInfo.email }} &nbsp;|&nbsp; {{ personalInfo.phonenumber }}
            {% for extra in personalInfo.extras or [] %}
            &nbsp;|&nbsp; {{ extra }}
            {% endfor %}
        </div>
    </header>

    {# ── Ordered sections ── #}
    {# Caller passes `sections` as a list like:
    [{"name": "summary", "enabled": true}, {"name": "jobs", "enabled": true}, ...]
    Order of the list determines render order. Disabled or empty sections are skipped. #}
    {% for section in sections %}
    {% if section.enabled %}

    {% if section.name == 'summary' %}
    {% if summary and summary.strip() %}
    <section class="section summary">
        <h2 class="section-title">Summary</h2>
        <p>{{ summary }}</p>
    </section>
    {% endif %}

    {% elif section.name == 'jobs' %}
    {% if jobs and jobs|length > 0 %}
    <section class="section">
        <h2 class="section-title">Work Experience</h2>
        {% for job in jobs %}
        <div class="section-item">
            <div class="section-item-header">
                <span class="section-item-primary">
                    {{ job.role }} — {{ job.company }}{% if job.location %} — {{ job.location }}{% endif %}
                </span>
                <span class="section-item-secondary">
                    {{ job.startDate }} - {{ job.endDate }}
                </span>
            </div>
            {% if job.bullets and job.bullets|length > 0 %}
            <ul class="section-item-bullets">
                {% for bullet in job.bullets %}
                <li>{{ bullet }}</li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        {% endfor %}
    </section>
    {% endif %}

    {% elif section.name == 'education' %}
    {% if education and education|length > 0 %}
    <section class="section">
        <h2 class="section-title">Education</h2>
        {% for entry in education %}
        <div class="section-item">
            <div class="section-item-header">
                <span class="section-item-primary">{{ entry.school }}</span>
                <span class="section-item-secondary">{{ entry.degree }}</span>
            </div>
            {% if entry.bullets and entry.bullets|length > 0 %}
            <ul class="section-item-bullets">
                {% for bullet in entry.bullets %}
                <li>{{ bullet }}</li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        {% endfor %}
    </section>
    {% endif %}

    {% elif section.name == 'projects' %}
    {% if projects and projects|length > 0 %}
    <section class="section">
        <h2 class="section-title">Projects</h2>
        {% for project in projects %}
        <div class="section-item">
            <div class="section-item-header">
                <span class="section-item-primary">{{ project.title }}</span>
            </div>
            {% if project.bullets and project.bullets|length > 0 %}
            <ul class="section-item-bullets">
                {% for bullet in project.bullets %}
                <li>{{ bullet }}</li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        {% endfor %}
    </section>
    {% endif %}

    {% elif section.name == 'skills' %}
    {% if skills and skills|length > 0 %}
    <section class="section">
        <h2 class="section-title">Technical Skills</h2>
        <div class="skills-list">
            {% for skill in skills %}
            <div class="skill-line">
                <span class="skill-category">{{ skill.title }}: </span>
                <span class="skill-values">{{ skill.text }}</span>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% endif %}

    {% endif %}
    {% endfor %}

</body>

</html>