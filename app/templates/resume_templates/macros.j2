{% macro linkable(value) -%}
    {% if value.url %}<a class="resume-link" href="{{ value.url }}">{{ value.text }}</a>{% else %}{{ value.text }}{% endif %}
{%- endmacro %}

{% macro external_link_icon() -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3h7v7"/><path d="M10 14 21 3"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>
{%- endmacro %}

{% macro github_icon() -%}
<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .7A11.5 11.5 0 0 0 8.36 23.1c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.36-3.9-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.3-5.28-1.29-5.28-5.72 0-1.26.45-2.3 1.2-3.1-.12-.3-.52-1.47.11-3.06 0 0 .97-.31 3.17 1.18A11 11 0 0 1 12 6.28c.98 0 1.96.13 2.88.39 2.2-1.5 3.17-1.18 3.17-1.18.63 1.6.23 2.77.11 3.06.75.8 1.2 1.84 1.2 3.1 0 4.45-2.71 5.42-5.3 5.7.42.36.79 1.07.79 2.16v3.03c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
{%- endmacro %}

{% macro summary(summary) %}
    {% if summary and summary.strip() %}
    <section class="section summary">
        <h2 class="section-title">Summary</h2>
        <p>{{ summary }}</p>
    </section>
    {% endif %}
{% endmacro %}

{% macro jobs(jobs) %}
    {% if jobs and jobs|length > 0 %}
    <section class="section">
        <h2 class="section-title">Work Experience</h2>
        {% for job in jobs %}
        {% if job.role.strip() or job.company.strip() %}
        {% set headline = [job.role, job.company, job.location] | map("default", "", true) | map("trim") | select | list %}
        {% set shown_bullets = job.bullets | map("trim") | select | list %}
        <div class="section-item">
            <div class="section-item-header">
                <span class="section-item-primary">
                    {{ headline | join(" — ") }}
                </span>
                <span class="section-item-secondary">
                    {{ job.start_date }} - {{ job.end_date }}
                </span>
            </div>
            {% if shown_bullets %}
            <ul class="section-item-bullets">
                {% for bullet in shown_bullets %}
                <li>{{ bullet }}</li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        {% endif %}
        {% endfor %}
    </section>
    {% endif %}
{% endmacro %}

{% macro education(education) %}
    {% if education and education|length > 0 %}
        <section class="section">
            <h2 class="section-title">Education</h2>
            {% for entry in education %}
            {% if entry.school.strip() or entry.degree.strip() %}
            {% set shown_bullets = entry.bullets | map("trim") | select | list %}
            <div class="section-item">
                <div class="section-item-header">
                    <span class="section-item-primary">{{ entry.school }}</span>
                    <span class="section-item-secondary">{{ entry.degree }}</span>
                </div>
                {% if shown_bullets %}
                <ul class="section-item-bullets">
                    {% for bullet in shown_bullets %}
                    <li>{{ bullet }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>
            {% endif %}
            {% endfor %}
        </section>
    {% endif %}
{% endmacro %}

{% macro projects(projects) %}
    {% if projects and projects|length > 0 %}
        <section class="section">
            <h2 class="section-title">Projects</h2>
            {% for project in projects %}
            {% if project.title.strip() %}
            {% set shown_bullets = project.bullets | map("trim") | select | list %}
            <div class="section-item">
                <div class="section-item-header">
                    <span class="section-item-primary project-title-editor">
                        <span class="project-title-primary">
                            <span>{{ project.title }}</span>
                            {% if project.website_url or project.github_url %}
                            <span class="project-link-controls">
                                {% if project.website_url %}<a class="project-link-control" href="{{ project.website_url }}" aria-label="Project website" title="Project website">{{ external_link_icon() }}</a>{% endif %}
                                {% if project.github_url %}<a class="project-link-control" href="{{ project.github_url }}" aria-label="GitHub repository" title="GitHub repository">{{ github_icon() }}</a>{% endif %}
                            </span>
                            {% endif %}
                        </span>
                        {% if project.description.strip() %}
                        <span class="project-title-description"><span aria-hidden="true">—</span><span>{{ project.description }}</span></span>
                        {% endif %}
                    </span>
                </div>
                {% if shown_bullets %}
                <ul class="section-item-bullets">
                    {% for bullet in shown_bullets %}
                    <li>{{ bullet }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>
            {% endif %}
            {% endfor %}
        </section>
    {% endif %}
{% endmacro %}
    
{% macro skills(skills) %}
    {% if skills and skills|length > 0 %}
        <section class="section">
            <h2 class="section-title">Skills</h2>
            <div class="skills-list">
                {% for skill in skills %}
                <div class="skill-line">
                    <span class="skill-category">{{ skill.title }}: </span>
                    <span class="skill-values">{{ skill.text }}</span>
                </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endmacro %}

{% macro render(section, resume_data) %}
    {% if section.name == "summary" %}
        {{ summary(resume_data.summary) }}
    {% elif section.name == "jobs" %}
        {{ jobs(resume_data.jobs) }}
    {% elif section.name == "education" %}
        {{ education(resume_data.education) }}
    {% elif section.name == "projects" %}
        {{ projects(resume_data.projects) }}
    {% elif section.name == "skills" %}
        {{ skills(resume_data.skills) }}
    {% endif %}
{% endmacro %}
