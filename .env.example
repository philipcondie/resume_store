# ENV file for setting up the resume-store repo
POSTGRES_USER=resume_store
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resume_store
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# ENVIRONMENT: set to "dev" for verbose SQL logging and permissive CORS; anything else means production-like
ENVIRONMENT=production

INVITE_CODE=change-me

# Timeouts for how long playwright should wait for a render and how long the render request should wait to get access to the render manager
RENDER_TIMEOUT=10
PDF_MANAGER_TIMEOUT=10

#  openssl rand -hex 32
JWT_SECRET=

# HS256 matches the symmetric JWT_SECRET; don't change unless you switch to asymmetric keys
JWT_ALGORITHM=HS256

# time in minutes
JWT_TOKEN_EXPIRES=60

# time in days
REFRESH_TOKEN_EXPIRES=30

CORS_ORIGINS=["http://localhost:5173","https://yourapp.com"]

ANTHROPIC_API_KEY=sk-ant-your-key-here
